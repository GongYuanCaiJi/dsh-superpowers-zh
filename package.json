{
  "name": "dsh-superpowers-zh",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：中文版 Superpowers 技能包，20 个中文 AI 编程 skills（移植自 superpowers-zh）",
  "type": "module",
  "main": "index.js",
  "bin": {
    "superpowers-zh": "bin/superpowers-zh.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "prepare": "node --test test/structure.test.js",
    "prepack": "node --test test/verbatim.test.js",
    "prepublishOnly": "npm test"
  },
  "files": [
    "bin/",
    "skills/",
    "hooks/",
    "assets/",
    ".claude-plugin/",
